# Everything the image builds for itself, or must never contain.
.git
.venv
venv
__pycache__
*.pyc
.pytest_cache
console/node_modules
console/dist
node_modules
_private
eval/results/sessions
pact.db
pact.db-wal
pact.db-shm
.env
.env.local
*.log
# Key material, by pattern rather than by name — the next key file will have
# a different one, and the image must not carry any of them. The gate
# generates its own on the mounted volume at first boot.
fixtures/keys/*.hex
*_signing_key.hex
